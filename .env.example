# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=smart_planter
POSTGRES_PORT=5432

# Backend Connection String
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=smart_planter;Username=postgres;Password=postgres_secure_pass

# Backend Host & Port
BACKEND_PORT=8000

# Telegram Bot (это для участника 3)
TELEGRAM_BOT_TOKEN=your_bot_token_here
API_BASE_URL=http://backend:8080/api/v1